FROM python:3.13-slim
RUN pip install --no-cache-dir cryptography
WORKDIR /app
COPY server/ /app/server/
COPY client/ /app/client/
COPY agent/ /app/agent/
COPY deploy/run_all.py /app/deploy/run_all.py
ENV SAFEVAULT_DATA=/data SAFEVAULT_AGENT_HOME=/data/agent SAFEVAULT_HOST=0.0.0.0 PYTHONUNBUFFERED=1
EXPOSE 8080
CMD ["python", "/app/deploy/run_all.py"]
